LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=
TELEGRAM_BOT_TOKEN=

# Configure an explicit staged detector, endpoint and independently deployed model IDs.
# EDITOR_DETECTOR=union
# EDITOR_JUDGES_JSON=[{"model":"Qwen/Qwen3.5-122B-A10B-FP8"},{"model":"google/gemma-3-27b-it","base_url":"http://127.0.0.1:8102/v1","api_key_env":"SECOND_MODEL_KEY"}]
# EDITOR_REWRITER=standard
# EDITOR_REWRITER_MODEL=
# EDITOR_REWRITER_BASE_URL=
# EDITOR_REWRITER_API_KEY=
# EDITOR_FIDELITY_CONSENSUS=1
# With this opt-in, EDITOR_JUDGES_JSON supplies independent rewrite judges. A verified reject vetoes the proposal.
# With the switch off, the original single-judge policy uses the following endpoint.
# EDITOR_FIDELITY_MODEL=
# EDITOR_FIDELITY_BASE_URL=
# EDITOR_FIDELITY_API_KEY=
# EDITOR_SEARCH_PROTOCOL=json
# Use mcp for a semantic agent with native read_blocks / locate_finding calls and feedback.
# EDITOR_KEYLESS_HOSTS=internal-inference.example.net
# By default only loopback endpoints accept a missing key. Different hosts never inherit the primary key.
